{
	# Plain HTTP on :80; TLS is expected to be handled in front (or by
	# GitHub Pages in the main deployment).
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	# Serve the site's own 404 page instead of Caddy's empty response.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
